FROM heroiclabs/nakama:3.21.1

# Install curl for health checks
USER root
RUN apt-get update && apt-get install -y curl && rm -rf /var/lib/apt/lists/*

# Create directories first
RUN mkdir -p /nakama/data/modules

# Create the match.js file directly
RUN echo 'let InitModule = function (ctx, logger, nk, initializer) {\n\
\n\
  initializer.registerMatch("tic-tac-toe", {\n\
    matchInit: function (ctx, logger, nk, params) {\n\
      return {\n\
        state: {\n\
          board: Array(9).fill(null),\n\
          turn: "X",\n\
          players: []\n\
        },\n\
        tickRate: 1,\n\
        label: "TicTacToe"\n\
      };\n\
    },\n\
\n\
    matchJoinAttempt: function (ctx, logger, nk, dispatcher, tick, state, presence, metadata) {\n\
      if (state.players.length >= 2) {\n\
        return { state, accept: false };\n\
      }\n\
      return { state, accept: true };\n\
    },\n\
\n\
    matchJoin: function (ctx, logger, nk, dispatcher, tick, state, presences) {\n\
      presences.forEach(p => state.players.push(p));\n\
\n\
      dispatcher.broadcastMessage(1, {\n\
        board: state.board,\n\
        turn: state.turn\n\
      });\n\
\n\
      return { state };\n\
    },\n\
\n\
    matchLoop: function (ctx, logger, nk, dispatcher, tick, state, messages) {\n\
      messages.forEach(msg => {\n\
        let data = JSON.parse(msg.data);\n\
\n\
        let { index } = data;\n\
\n\
        // ❗ SERVER VALIDATION\n\
        if (state.board[index] !== null) return;\n\
\n\
        state.board[index] = state.turn;\n\
\n\
        // switch turn\n\
        state.turn = state.turn === "X" ? "O" : "X";\n\
\n\
        dispatcher.broadcastMessage(1, {\n\
          board: state.board,\n\
          turn: state.turn\n\
        });\n\
      });\n\
\n\
      return { state };\n\
    }\n\
  });\n\
};\n\
\n\
module.exports = { InitModule };' > /nakama/data/modules/match.js

# Create a minimal config.yml (database will be set via command line)
RUN echo 'name: nakama-railway\n\
data_dir: "./data/"\n\
\n\
logger:\n\
  level: "DEBUG"\n\
  stdout: true\n\
\n\
session:\n\
  encryption_key: "defaultencryptionkey"\n\
  token_expiry_sec: 7200\n\
\n\
socket:\n\
  server_key: "defaultkey"\n\
  port: 7350\n\
  address: "0.0.0.0"\n\
  protocol: "tcp"\n\
\n\
runtime:\n\
  js_entrypoint: "match.js"' > /nakama/data/config.yml

# Railway config is now embedded above

# Create startup script for Railway
RUN echo '#!/bin/sh\n\
echo "🚀 Starting Nakama server on Railway..."\n\
echo "🔌 Port: $PORT"\n\
echo "📊 Database environment variables:"\n\
env | grep -E "(PG|DATABASE)" | sed "s/PASSWORD=.*/PASSWORD=***/" | sort\n\
echo ""\n\
\n\
# Try multiple approaches to get the right database connection\n\
if [ -n "$DATABASE_URL" ]; then\n\
    echo "✅ Attempting DATABASE_URL connection..."\n\
    \n\
    # Method 1: Direct URL (some Railway setups)\n\
    echo "🔄 Method 1: Direct DATABASE_URL"\n\
    if /nakama/nakama check --database.address "$DATABASE_URL" 2>/dev/null; then\n\
        NAKAMA_DB_ADDRESS="$DATABASE_URL"\n\
        echo "✅ Method 1 works!"\n\
    else\n\
        echo "❌ Method 1 failed"\n\
        \n\
        # Method 2: Remove postgresql:// prefix\n\
        echo "🔄 Method 2: Remove postgresql:// prefix"\n\
        DB_ADDR_2=$(echo "$DATABASE_URL" | sed "s|postgresql://||")\n\
        if /nakama/nakama check --database.address "$DB_ADDR_2" 2>/dev/null; then\n\
            NAKAMA_DB_ADDRESS="$DB_ADDR_2"\n\
            echo "✅ Method 2 works!"\n\
        else\n\
            echo "❌ Method 2 failed"\n\
            \n\
            # Method 3: Replace postgresql with postgres\n\
            echo "🔄 Method 3: Use postgres:// instead"\n\
            DB_ADDR_3=$(echo "$DATABASE_URL" | sed "s|postgresql://|postgres://|")\n\
            if /nakama/nakama check --database.address "$DB_ADDR_3" 2>/dev/null; then\n\
                NAKAMA_DB_ADDRESS="$DB_ADDR_3"\n\
                echo "✅ Method 3 works!"\n\
            else\n\
                echo "❌ All methods failed, using Method 2 anyway"\n\
                NAKAMA_DB_ADDRESS="$DB_ADDR_2"\n\
            fi\n\
        fi\n\
    fi\n\
else\n\
    echo "❌ ERROR: DATABASE_URL not found!"\n\
    exit 1\n\
fi\n\
\n\
echo "🔗 Final DB Address: ${NAKAMA_DB_ADDRESS%%:*}:***@..."\n\
\n\
# Run migrations\n\
echo "📦 Running database migrations..."\n\
/nakama/nakama migrate up --database.address "$NAKAMA_DB_ADDRESS" || {\n\
    echo "⚠️  Migrations failed, but continuing..."\n\
}\n\
\n\
# Start Nakama server\n\
echo "🎮 Starting Nakama game server..."\n\
exec /nakama/nakama \\\n\
    --name nakama-railway \\\n\
    --database.address "$NAKAMA_DB_ADDRESS" \\\n\
    --logger.level DEBUG \\\n\
    --session.token_expiry_sec 7200 \\\n\
    --runtime.http_key defaultkey \\\n\
    --socket.server_key defaultkey \\\n\
    --socket.port ${PORT:-7350} \\\n\
    --socket.address 0.0.0.0' > /start-railway.sh && chmod +x /start-railway.sh

# Expose the port (Railway will set PORT environment variable)
EXPOSE 7349 7350 7351 9100

# Health check for Railway
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
  CMD curl -f http://localhost:${PORT:-7350}/ || exit 1

# Use Railway startup script
CMD ["/start-railway.sh"]