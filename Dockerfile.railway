FROM heroiclabs/nakama:3.21.1

# Install curl for health checks
USER root
RUN apt-get update && apt-get install -y curl && rm -rf /var/lib/apt/lists/*

# Create directories first
RUN mkdir -p /nakama/data/modules

# Create the match.js file directly
RUN echo 'let InitModule = function (ctx, logger, nk, initializer) {\n\
\n\
  initializer.registerMatch("tic-tac-toe", {\n\
    matchInit: function (ctx, logger, nk, params) {\n\
      return {\n\
        state: {\n\
          board: Array(9).fill(null),\n\
          turn: "X",\n\
          players: []\n\
        },\n\
        tickRate: 1,\n\
        label: "TicTacToe"\n\
      };\n\
    },\n\
\n\
    matchJoinAttempt: function (ctx, logger, nk, dispatcher, tick, state, presence, metadata) {\n\
      if (state.players.length >= 2) {\n\
        return { state, accept: false };\n\
      }\n\
      return { state, accept: true };\n\
    },\n\
\n\
    matchJoin: function (ctx, logger, nk, dispatcher, tick, state, presences) {\n\
      presences.forEach(p => state.players.push(p));\n\
\n\
      dispatcher.broadcastMessage(1, {\n\
        board: state.board,\n\
        turn: state.turn\n\
      });\n\
\n\
      return { state };\n\
    },\n\
\n\
    matchLoop: function (ctx, logger, nk, dispatcher, tick, state, messages) {\n\
      messages.forEach(msg => {\n\
        let data = JSON.parse(msg.data);\n\
\n\
        let { index } = data;\n\
\n\
        // ❗ SERVER VALIDATION\n\
        if (state.board[index] !== null) return;\n\
\n\
        state.board[index] = state.turn;\n\
\n\
        // switch turn\n\
        state.turn = state.turn === "X" ? "O" : "X";\n\
\n\
        dispatcher.broadcastMessage(1, {\n\
          board: state.board,\n\
          turn: state.turn\n\
        });\n\
      });\n\
\n\
      return { state };\n\
    }\n\
  });\n\
};\n\
\n\
module.exports = { InitModule };' > /nakama/data/modules/match.js

# Create the config.yml file directly  
RUN echo 'name: nakama-railway\n\
data_dir: "./data/"\n\
\n\
logger:\n\
  level: "INFO"\n\
  stdout: true\n\
  file: ""\n\
\n\
metrics:\n\
  reporting_freq_sec: 60\n\
  prometheus_port: 9100\n\
\n\
session:\n\
  encryption_key: "defaultencryptionkey"\n\
  token_expiry_sec: 7200\n\
\n\
socket:\n\
  server_key: "defaultkey"\n\
  port: 7350\n\
  address: "0.0.0.0"\n\
  protocol: "tcp"\n\
  max_message_size_bytes: 4096\n\
\n\
runtime:\n\
  js_entrypoint: "match.js"' > /nakama/data/config.yml

# Railway config is now embedded above

# Create startup script for Railway
RUN echo '#!/bin/sh\n\
echo "🚀 Starting Nakama server on Railway..."\n\
echo "🔌 Port: $PORT"\n\
echo "📊 Available env vars:"\n\
env | grep -E "(PG|DATABASE)" | sed "s/PASSWORD=.*/PASSWORD=***/" | sort\n\
echo ""\n\
\n\
# Simple approach: use DATABASE_URL directly with Nakama format conversion\n\
if [ -n "$DATABASE_URL" ]; then\n\
    echo "✅ Found DATABASE_URL"\n\
    # Convert postgresql://user:pass@host:port/db to user:pass@host:port/db\n\
    NAKAMA_DB_ADDRESS=$(echo "$DATABASE_URL" | sed "s|postgresql://||")\n\
    echo "🔗 Nakama DB Address format: ${NAKAMA_DB_ADDRESS%%:*}:***@..."\n\
elif [ -n "$POSTGRES_URL" ]; then\n\
    echo "✅ Found POSTGRES_URL (fallback)"\n\
    NAKAMA_DB_ADDRESS=$(echo "$POSTGRES_URL" | sed "s|postgres://||")\n\
    echo "🔗 Using POSTGRES_URL"\n\
else\n\
    echo "❌ ERROR: No DATABASE_URL or POSTGRES_URL found!"\n\
    echo "Available env vars:"\n\
    env | sort\n\
    exit 1\n\
fi\n\
\n\
# Skip connection testing - let Nakama handle it\n\
echo "📦 Running database migrations..."\n\
/nakama/nakama migrate up --database.address "$NAKAMA_DB_ADDRESS" 2>&1 || {\n\
    echo "⚠️  Migration failed or database not ready, continuing..."\n\
}\n\
\n\
# Start Nakama server with robust settings\n\
echo "🎮 Starting Nakama game server..."\n\
exec /nakama/nakama \\\n\
    --name nakama-railway \\\n\
    --database.address "$NAKAMA_DB_ADDRESS" \\\n\
    --logger.level DEBUG \\\n\
    --session.token_expiry_sec 7200 \\\n\
    --runtime.http_key defaultkey \\\n\
    --socket.server_key defaultkey \\\n\
    --socket.port ${PORT:-7350} \\\n\
    --socket.address 0.0.0.0 \\\n\
    --console.port 7351 \\\n\
    --metrics.prometheus_port 9100' > /start-railway.sh && chmod +x /start-railway.sh

# Expose the port (Railway will set PORT environment variable)
EXPOSE 7349 7350 7351 9100

# Health check for Railway
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
  CMD curl -f http://localhost:${PORT:-7350}/ || exit 1

# Use Railway startup script
CMD ["/start-railway.sh"]