FROM heroiclabs/nakama:3.21.1

# Install curl for health checks
USER root
RUN apt-get update && apt-get install -y curl && rm -rf /var/lib/apt/lists/*

# Create directories and embed configuration directly for reliability
RUN mkdir -p /nakama/data/modules

# Create the Nakama configuration
RUN cat > /nakama/data/config.yml << 'EOF'
name: nakama-production
data_dir: "./data/"

logger:
  level: "INFO"  
  stdout: true

metrics:
  reporting_freq_sec: 60
  prometheus_port: 9100

session:
  encryption_key: "defaultencryptionkey"
  token_expiry_sec: 7200

socket:
  server_key: "defaultkey"
  port: 7350
  address: "0.0.0.0"
  protocol: "tcp"
  max_message_size_bytes: 4096

runtime:
  js_entrypoint: "match.js"
EOF

# Create a basic match.js (can be overridden by volume mount in docker-compose)
RUN cat > /nakama/data/modules/match.js << 'EOF'
let InitModule = function (ctx, logger, nk, initializer) {
  logger.info("Basic Tic-Tac-Toe match handler loaded");
  
  initializer.registerMatch("tic-tac-toe", {
    matchInit: function (ctx, logger, nk, params) {
      return {
        state: {
          board: Array(9).fill(null),
          currentPlayer: 'X',
          players: {}
        },
        tickRate: 1,
        label: "Tic-Tac-Toe"
      };
    },

    matchJoinAttempt: function (ctx, logger, nk, dispatcher, tick, state, presence, metadata) {
      if (Object.keys(state.players).length >= 2) {
        return { state, accept: false };
      }
      return { state, accept: true };
    },

    matchJoin: function (ctx, logger, nk, dispatcher, tick, state, presences) {
      presences.forEach(presence => {
        const userId = presence.user_id;
        const username = presence.username;
        const playerSymbol = Object.keys(state.players).length === 0 ? 'X' : 'O';
        state.players[userId] = {
          sessionId: presence.session_id,
          username: username,
          symbol: playerSymbol
        };
      });

      dispatcher.broadcastMessage(2, JSON.stringify({
        type: 'player_joined',
        board: state.board,
        players: state.players,
        currentPlayer: state.currentPlayer
      }));

      return { state };
    },

    matchLeave: function (ctx, logger, nk, dispatcher, tick, state, presences) {
      presences.forEach(presence => {
        delete state.players[presence.user_id];
      });
      return { state };
    },

    matchLoop: function (ctx, logger, nk, dispatcher, tick, state, messages) {
      messages.forEach(message => {
        try {
          const data = JSON.parse(message.data);
          const position = data.position;
          
          if (position >= 0 && position <= 8 && state.board[position] === null) {
            state.board[position] = state.currentPlayer;
            state.currentPlayer = state.currentPlayer === 'X' ? 'O' : 'X';
            
            dispatcher.broadcastMessage(2, JSON.stringify({
              type: 'move_made',
              board: state.board,
              currentPlayer: state.currentPlayer,
              lastMove: position
            }));
          }
        } catch (error) {
          logger.error("Error processing message: " + error.message);
        }
      });

      return { state };
    }
  });
};

module.exports = { InitModule };
EOF

# Create startup script that works with Render's database URL
RUN echo '#!/bin/sh\n\
echo "🚀 Starting Nakama server..."\n\
echo "🔌 Port: $PORT"\n\
echo "📊 Database URL detected: $(echo $DATABASE_URL | cut -d@ -f2)"\n\
\n\
# Convert DATABASE_URL to Nakama format\n\
if [ -n "$DATABASE_URL" ]; then\n\
    # Extract components from DATABASE_URL\n\
    DB_ADDR=$(echo "$DATABASE_URL" | sed "s|postgresql://||" | sed "s|postgres://||")\n\
    echo "🔗 Using database: $DB_ADDR"\n\
else\n\
    echo "❌ ERROR: DATABASE_URL not found!"\n\
    exit 1\n\
fi\n\
\n\
# Run migrations\n\
echo "📦 Running database migrations..."\n\
/nakama/nakama migrate up --database.address "$DB_ADDR" || {\n\
    echo "⚠️ Migrations failed, continuing anyway..."\n\
}\n\
\n\
# Start Nakama server\n\
echo "🎮 Starting Nakama game server on port ${PORT:-7350}..."\n\
exec /nakama/nakama \\\n\
    --name nakama-production \\\n\
    --database.address "$DB_ADDR" \\\n\
    --logger.level ${NAKAMA_LOGGER_LEVEL:-INFO} \\\n\
    --session.token_expiry_sec 7200 \\\n\
    --runtime.http_key defaultkey \\\n\
    --socket.server_key defaultkey \\\n\
    --socket.port ${PORT:-7350} \\\n\
    --socket.address 0.0.0.0 \\\n\
    --console.port 7351' > /start.sh && chmod +x /start.sh

# Switch back to nakama user for security
USER nakama

# Expose ports
EXPOSE 7350 7351

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
  CMD curl -f http://localhost:${PORT:-7350}/ || exit 1

# Use our startup script
CMD ["/start.sh"]